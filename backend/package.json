{
  "name": "pipeline-domovina-backend",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pipeline_domovina --local",
    "db:migrate:prod": "wrangler d1 migrations apply pipeline_domovina --remote",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test '.test-build/*.mjs'"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.6.14",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
